# Copy to .env for local runs, or set these in Railway → Variables.
# Only TELEGRAM_* and one Sleeper identifier are strictly required.

# --- Telegram (required) ---------------------------------------------------
# Create a bot with @BotFather to get the token.
TELEGRAM_TOKEN=123456:ABC-your-bot-token
# Your chat id. DM @userinfobot on Telegram to get it. The bot only responds
# to (and pushes digests to) this chat.
TELEGRAM_CHAT_ID=123456789

# --- Sleeper (one repo can run many leagues; set these per service) ---------
# Identify the manager's team (either works):
SLEEPER_USER_ID=1267645505593147392
# SLEEPER_USERNAME=your_sleeper_username
# Then point at the league ONE of two ways (set at least one):
#   LEAGUE_ID   — pin one specific league (most explicit).
# LEAGUE_ID=1251988282942685184
#   LEAGUE_NAME — auto-detect by name each season from your leagues, so it
#                 follows you into next year's re-draft with no edits.
LEAGUE_NAME=Show me your TDs
# Season is derived from the resolved league; only set to override.
# SEASON=2026
# League format: redraft | dynasty | keeper. Redraft makes Grok prioritize
# THIS-season value and discount dynasty/rookie-stash takes.
# LEAGUE_FORMAT=redraft
# Comma-separated X handles (no @) whose takes Grok should weight most. Leave
# unset to use the built-in curated list. Search still runs broadly so breaking
# beat-reporter news isn't missed.
# X_TRUSTED_HANDLES=PFF_Fantasy,Ihartitz,HaydenWinks,EricNMoody,DBro_FFB

# --- xAI Grok Live Search (optional; enables /player and live buzz) --------
# Get a key at https://console.x.ai/. Without it, the bot still works using
# Sleeper's trending-adds signal; you just won't get X/news buzz.
XAI_API_KEY=
# GROK_MODEL=grok-4.5
# GROK_LOOKBACK_DAYS=3
# Set to true to hard-restrict the X search to your trusted handles (max 20).
# X_RESTRICT_TO_HANDLES=false

# --- Scheduling (optional; sensible defaults shown) ------------------------
# TIMEZONE=America/New_York
# Weekday index: Mon=0 ... Sun=6. Times are HH:MM in TIMEZONE.
# PRE_DIGEST_DAY=1
# PRE_DIGEST_TIME=20:00
# POST_DIGEST_DAY=2
# POST_DIGEST_TIME=09:00
# GAMEDAY_DAY=6
# GAMEDAY_TIME=11:00
